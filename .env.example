# ==============================================================================
# Cymbal Retail Operations Agent — Environment Configuration Template
# Copy this file to `.env` and populate with your environment-specific values.
# ==============================================================================

# Google Cloud & Vertex AI Configuration
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
PROJECT_ID=your-gcp-project-id
REGION=us-central1

# Agent Model Configuration
AGENT_MODEL=gemini-3.6-flash
EVAL_JUDGE_MODEL=gemini-3.7-flash

# BigQuery Conversational Data Agent (Lab 3-2)
# Must use 'global' location to avoid regional mTLS certificate routing issues
DATA_AGENT_LOCATION=global
DATA_AGENT_ID=cymbal_retail_analytics_data_agent

# BigQuery Datasets & Tables (Lab 3-1 & Lab 3-3)
BQ_GOLD_DATASET=cymbal_gold
BQ_UNSTRUCTURED_DATASET=module1_unstructureddata
POS_EMBEDDING_TABLE=pos_manual_chunk_embeddings
POS_BASELINE_EMBEDDING_TABLE=pos_manual_embeddings
POS_EMBEDDING_MODEL=text-embedding-005
RAG_SIMILARITY_THRESHOLD=0.65
RAG_VECTOR_STRICT_THRESHOLD=0.70

# Query Cost & Resource Guardrail (10 GB default cap)
MAX_BYTES_BILLED=10737418240

# Cloud Run MCP Toolbox for Cloud Bigtable (Lab 3-3)
BIGTABLE_MCP_URL=https://mcp-toolbox-bigtable-000000000000.us-central1.run.app
BIGTABLE_INSTANCE_ID=operations-db
BIGTABLE_TABLE_ID=cashier_realtime_alerts

# BigQuery Agent Analytics Telemetry Plugin (Lab 3-4)
BQ_TELEMETRY_DATASET=agent_telemetry
BQ_ANALYTICS_DATASET_ID=agent_telemetry
BQ_TELEMETRY_TABLE=events

# Service Account for Vertex AI Agent Runtime Deployment
AGENT_SERVICE_ACCOUNT=cymbal-sa-data@your-gcp-project-id.iam.gserviceaccount.com
